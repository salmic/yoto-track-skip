{
  "name": "yoto-track-skip",
  "version": "1.0.0",
  "description": "Auto-skip configured tracks on Yoto cards",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:web": "npm run dev --prefix web",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc && node -e \"require('node:fs').mkdirSync('dist/db',{recursive:true}); require('node:fs').copyFileSync('src/db/schema.sql','dist/db/schema.sql')\"",
    "build:web": "npm run build --prefix web",
    "start": "node dist/index.js",
    "stop": "node scripts/stop.mjs",
    "restart": "npm run stop && npm start",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/patch-yoto-client.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "yoto-nodejs-client": "^0.0.11"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
