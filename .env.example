YOTO_CLIENT_ID=your-yoto-client-id
YOTO_CLIENT_SECRET=
PUBLIC_BASE_URL=http://localhost:3847
PORT=3847
DATA_DIR=./data
HOST=0.0.0.0

# Railway sets PORT and RAILWAY_PUBLIC_DOMAIN automatically.
# Mount a volume at /data and set DATA_DIR=/data to persist skip profiles.

# Only if Yoto pre-approved this scope for your developer app:
# YOTO_OPTIONAL_SCOPES=family:device-status:view
